//       xaxis: (
//         ticks: ((0.0, [0]), (1/3, [$1/3$]), (2/3, [$2/3$]), (1.0, [1])),
//         subticks: none,
//       ),
//       ..plots,
//     )
//   },
//   caption: [Рис. 1.6. Функция Кантора.],
