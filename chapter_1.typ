  ..frame8,
  ..rows8.map(y => lq.line((0, y), (1, y), stroke: 0.8pt + black)),
  dots8((0.5,) * 3, (0.38, 0.28, 0.18)),
  lq.line((0, 0), (1, 0), stroke: 0.8pt + black),
  lq.place(0, 0, align: right, pad(right: 3pt, $f_(n_oo)$)),
  lq.place(0.5, -0.15, $?$),
)

#let diag-b = {
  let x-of(y) = 0.02 + (1.1 - y) / 1.3 * 0.85
  lq.diagram(
    ..frame8,
    ..rows8.map(y => lq.line((0, y), (1, y), stroke: 0.8pt + black)),
    lq.line((x-of(1.1), 1.1), (x-of(-0.2), -0.2), stroke: 0.8pt + black, clip: false),
    dots8((0.38, 0.28, 0.18).map(y => x-of(y) - 0.06), (0.38, 0.28, 0.18)),
  )
}

#fig(grid(
  columns: 2,
  column-gutter: 1.5cm,
